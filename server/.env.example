PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/skillswap
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_EXPIRES=1d
CLIENT_URL=http://localhost:5173

# Optional: enables the generative AI assistant (falls back to rule-based answers when unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Tests: point at a MongoDB server (no db name) or set USE_MEMORY_SERVER=true
MONGO_URI_TEST=mongodb://127.0.0.1:27017
USE_MEMORY_SERVER=false
